doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='preconnect' href='https://fonts.gstatic.com')
    link(href='https://fonts.googleapis.com/css2?family=Sacramento&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/stylesheets/style.css')
  body
    aside#leftside
    aside#rightside
    #container
      header
        span Food Blog
      main
        aside#photos
          img(src='/images/chili.jpg' alt='White Chicken Chili' width='180')
        h2 Comments
        section#blogposts
          ul
            li.posts(v-for='post in posts' :key='post.name')
              span.profile
                img(:src='post.profilepic' :alt='post.name + " profile"' @click='authorinfo(post)')
              span.author {{ post.name }}
              |  — 
              span.date {{ post.date }}
              span.reply {{ post.reply }}
              p {{ post.message }}
          .info-box(v-if='selectedPost')
            p.close-btn.close-btn-text(@click='selectedPost = null') &#10006;
            #info-title {{ selectedPost.name }}
            #info-foodie
              span Foodie Level: 
              | {{ selectedPost.foodielevel }}
            #info-bio
              span Bio:
              br
              | {{ selectedPost.bio }}
            button.close-btn.close-btn-button(@click='selectedPost = null') Close
      footer &copy; Copyright FOOD BLOG
    script(src='https://cdn.jsdelivr.net/npm/vue@2.6.12/dist/vue.js')
    script(src='/javascripts/blog.js')
