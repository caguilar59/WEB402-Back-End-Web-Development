extends layout

block content
    -data = data || {}

    header
        nav
            ul.nav-links
                li: a(href='/') Home
                li |
                li: a(href='#') Blog
            a.nav-register(href='/register') Register
    main.registration-layout
        section.registration-brand
            span Simple Kitchen
            p Simple &amp; Comforting
                br
                | Recipes All Year Round
        section.registration-panel.listing-reg
            if errors && errors.length
                ul.my-errors
                    each error in errors
                        li= error.msg
            h1 Register to subscribe
            form(action='/register' method='POST' class='form-registration')
                label(for='name') Name:
                input(type='text' id='name' name='name' class='form-control' value=data.name)
                label(for='email') Email:
                input(type='email' id='email' name='email' class='form-control' value=data.email)
                input(type='submit' value='Register' class='btn btn-lg btn-primary btn-block')
    footer &copy; Copyright 2021
